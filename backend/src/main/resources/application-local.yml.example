# Copy to application-local.yml (gitignored) and run with:  mvn spring-boot:run -Dspring-boot.run.profiles=local

spring:
  datasource:
    # Windows authentication: connects as the Windows user running the backend.
    # Needs mssql-jdbc_auth-<driver version>.x64.dll on PATH; dev-env.ps1 / dev-env.sh take care of that.
    url: jdbc:sqlserver://localhost:1433;databaseName=eshop;encrypt=true;trustServerCertificate=true;integratedSecurity=true
    username:
    password:
    # SQL authentication instead (server must be in mixed mode):
    # url: jdbc:sqlserver://localhost:1433;databaseName=eshop;encrypt=true;trustServerCertificate=true
    # username: eshop
    # password: CHANGE_ME
  security:
    oauth2:
      client:
        registration:
          # Remove a block you have no credentials for; its login button disappears automatically.
          google:
            client-id: YOUR_GOOGLE_CLIENT_ID
            client-secret: YOUR_GOOGLE_CLIENT_SECRET
            scope: openid,profile,email
          facebook:
            client-id: YOUR_FACEBOOK_APP_ID
            client-secret: YOUR_FACEBOOK_APP_SECRET
            scope: email,public_profile

eshop:
  admin:
    email: admin@eshop.local
    password: Admin123!
