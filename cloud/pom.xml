<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- Aggregator + shared parent for the Spring Cloud sample: Eureka discovery, gateway, two microservices.
	     Build/test everything from here: mvn verify -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.2.0</version>
		<relativePath/>
	</parent>
	<groupId>com.example.cloud</groupId>
	<artifactId>cloud-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>cloud-parent</name>
	<description>Spring Cloud sample: service discovery, API gateway and microservices</description>

	<modules>
		<module>discovery-server</module>
		<module>gateway</module>
		<module>arithmetic-service</module>
		<module>string-service</module>
		<module>auth-server</module>
		<module>ai-service</module>
	</modules>

	<properties>
		<java.version>27</java.version>
		<!-- Spring Cloud release train matching Spring Boot 4.2 (see start.spring.io/actuator/info "bom-ranges") -->
		<spring-cloud.version>2026.0.0</spring-cloud.version>
		<!-- Spring AI release for Boot 4.2 (same "bom-ranges" source) -->
		<spring-ai.version>2.1.0</spring-ai.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.ai</groupId>
				<artifactId>spring-ai-bom</artifactId>
				<version>${spring-ai.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
